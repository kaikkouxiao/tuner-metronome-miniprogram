/* pages/index/index.wxss */
.page { min-height: 100vh; }

/* 搜索栏 */
.search-bar {
  background: #26221f;
  padding: 16rpx 30rpx 24rpx;
}
.search-box {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
}
.search-icon { color: #e8b04b; margin-right: 12rpx; }
.search-box input { color: #fff; font-size: 26rpx; flex: 1; }

/* 轮播图 */
.banner { height: 260rpx; margin: 24rpx 30rpx 0; border-radius: 16rpx; overflow: hidden; }
.banner image { width: 100%; height: 100%; }

/* 九宫格 */
.grid {
  background: #ffffff;
  margin: 24rpx 30rpx 0;
  border-radius: 16rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}
.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #26221f;
  color: #e8b04b;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-name { margin-top: 14rpx; font-size: 24rpx; color: #555; }

/* 列表 */
.section-title {
  margin: 32rpx 30rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #26221f;
}
.section-title::before { content: '♪ '; color: #e8b04b; }
.list {
  background: #ffffff;
  margin: 0 30rpx 30rpx;
  border-radius: 16rpx;
}
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx dashed #e3ddd5;
}
.list-item:last-child { border-bottom: none; }
.list-name { font-size: 30rpx; font-weight: 500; }
.list-desc { font-size: 24rpx; color: #9a938a; margin-top: 8rpx; }
.list-tag {
  font-size: 22rpx;
  color: #e8b04b;
  border: 2rpx solid #e8b04b;
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}
